{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^(r|i|hb)[0-9a-f]{8}[-0-9a-f]{8,9}$/)",
        ".write": "$room.matches(/^(r|i|hb)[0-9a-f]{8}[-0-9a-f]{8,9}$/)",

        "app": { ".validate": "newData.isString() && newData.val() == 'itookashi'" },
        "hostId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{10}$/)" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "guestId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{10}$/)" },
        "guestName": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "digits": { ".validate": "newData.val() == 3 || newData.val() == 4" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "settings": {
          "chat": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "members": {
          "$pid": {
            ".validate": "$pid.matches(/^[a-z0-9]{10}$/)",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "msgs": {
          "$msg": {
            ".validate": "$msg.length <= 24",
            "round": { ".validate": "newData.isNumber()" },
            "kind": { ".validate": "newData.isString() && newData.val().matches(/^(q|a|host|chat|sys)$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "by": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{10}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "at": { ".validate": "newData.isNumber()" },
            "answer": { ".validate": "newData.val() == 'はい' || newData.val() == 'いいえ' || newData.val() == '関係ありません' || newData.val() == 'どちらとも言えない'" },
            "verdict": { ".validate": "newData.val() == '正解' || newData.val() == 'おしい' || newData.val() == 'ちがう'" },
            "important": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "game": {
          "round": { ".validate": "newData.isNumber()" },
          "digits": { ".validate": "newData.val() == 3 || newData.val() == 4" },

          "title": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "level": { ".validate": "(newData.isString() && newData.val().length <= 10) || newData.isNumber()" },
          "story": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "question": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "keyCount": { ".validate": "newData.isNumber()" },
          "revealed": { ".validate": "newData.isBoolean()" },
          "truth": { ".validate": "newData.isString() && newData.val().length <= 800" },
          "keyPoints": {
            "$i": { ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 100" }
          },
          "solvedBy": { ".validate": "newData.isString() && newData.val().length <= 16" },

          "miss": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(play|clear)$/)" },
          "topic": {
            "t": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "lo": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "hi": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          },
          "hands": {
            "$pid": {
              ".validate": "$pid.matches(/^[a-z0-9]{10}$/)",
              "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "cards": {
                "$i": {
                  ".validate": "$i.matches(/^[0-9]{1,2}$/)",
                  "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
                  "state": { ".validate": "newData.isString() && newData.val().matches(/^(hand|played|miss)$/)" },
                  "hint": { ".validate": "newData.isString() && newData.val().length <= 30" },
                  "$other": { ".validate": false }
                }
              },
              "$other": { ".validate": false }
            }
          },
          "pile": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/)",
              "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "hint": { ".validate": "newData.isString() && newData.val().length <= 30" },
              "miss": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },

          "ready": {
            "$pid": { ".validate": "$pid.matches(/^[a-z0-9]{10}$/) && newData.val() == true" }
          },
          "guesses": {
            "$g": {
              ".validate": "$g.length <= 24",
              "by": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{10}$/)" },
              "text": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{3,4}$/)" },
              "at": { ".validate": "newData.isNumber()" },
              "hit": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
              "blow": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
              "$other": { ".validate": false }
            }
          },
          "reveal": {
            "$pid": { ".validate": "$pid.matches(/^[a-z0-9]{10}$/) && newData.isString() && newData.val().matches(/^[0-9]{3,4}$/)" }
          },

          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
